# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Virtual environments
venv/
env/
.venv/
ENV/
hotwire-venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs (generated at runtime)
EVSE_LOG/
# Exception: preserve the historical Luxgen N7 forced-discharge bench
# logs imported from the original repository main branch. These are
# the raw Attack A2 evidence captures referenced in the paper.
!EVSE/EVSE_LOG/
!EVSE/EVSE_LOG/*.txt
sessions/
*.log
*.jsonl
PevExiLog.txt
RawExiLog.txt
MacLog.txt
DemoExiLog.txt
*.decoded.txt

# Config — the template at config/hotwire.ini IS tracked; only a user's
# personal copy in the project root (or legacy pyPlc.ini) is ignored.
/hotwire.ini
/pyPlc.ini

# Artifacts
*.pcap
*.pcapng
results/output/

# Exception: curated paper-§6 evidence under datasets/real_hw_traces/.
# We keep the DE-IDENTIFIED text logs (session.jsonl) and decoded CSVs
# tracked, but NOT raw pcaps -- those contain real link-layer / EVCCID
# identifiers (incl. a production vehicle) and are kept out of the repo.
!datasets/real_hw_traces/**/*.jsonl

# Archive (git-ignored — large legacy folder)
archive/

# OpenV2Gx build artifacts (source lives in vendor/OpenV2Gx as a submodule).
vendor/OpenV2Gx/Debug/
vendor/OpenV2Gx/Release/*.o
vendor/OpenV2Gx/Release/*.d
vendor/OpenV2Gx/Release/src/
vendor/OpenV2Gx/Release/OpenV2G.exe

# OpenV2G EXI codec - platform-specific binaries built locally per-host
# from vendor/OpenV2Gx/. See scripts/build_codec.sh / build_codec.ps1.
# Linux binary is ignored because Linux hosts always rebuild from source
# (the AEC's documented Linux path apt-installs build-essential and
# verify_artifact.sh's F0 step compiles vendor/OpenV2Gx on first run).
# Windows binary IS tracked because Git Bash on Windows does NOT ship
# gcc and we can't tell a reviewer to install MinGW just to compile a
# 1.5 MB EXI codec - so the .exe rides along with the repo.
hotwire/exi/codec/OpenV2G
# hotwire/exi/codec/OpenV2G.exe  - intentionally tracked for Windows F0

# OpenV2G rebuild artifacts
vendor/_build_openv2g/


# Hardware-check artefacts
runs/

# Docker CI artefacts (bind-mounted from container)
reports/

# Paper sources are kept out of the public repository — only PDFs are
# distributed (as part of the artifact bundle). LaTeX sources live in
# a separate writing repo, not here.
paper/
*.tex
*.aux
*.bbl
*.blg
*.bcf
*.run.xml
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.out

